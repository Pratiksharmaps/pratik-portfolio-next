# ============================================
# PRATIK SHARMA PORTFOLIO — ENV VARIABLES
# Copy this to .env.local and fill in values
# ============================================

# Admin Panel Password (choose a strong password)
ADMIN_PASSWORD=your_strong_password_here

# JWT Secret (random 32+ char string)
JWT_SECRET=your_jwt_secret_here_make_it_long_and_random

# Email (Nodemailer via Gmail SMTP)
# Enable "App Passwords" in your Google Account > Security
GMAIL_USER=pratik.sde16@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password_here
CONTACT_RECEIVER=pratik.sde16@gmail.com

# Google Analytics (from analytics.google.com)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://pratik-portfolio-oevs.vercel.app

# Availability (shown on Hero, Navbar, About profile card, Contact)
NEXT_PUBLIC_IS_AVAILABLE=true
NEXT_PUBLIC_AVAILABILITY_STATUS=Available — Full-time & Contract
NEXT_PUBLIC_AVAILABILITY_BADGE=Available for opportunities
NEXT_PUBLIC_AVAILABILITY_NAVBAR=Currently Available
NEXT_PUBLIC_AVAILABILITY_CONTACT_TITLE=🟢 Currently Available
NEXT_PUBLIC_AVAILABILITY_DETAIL=Open to full-time Flutter Developer roles (on-site Gurgaon / remote), freelance projects, and consulting engagements.
# Joining timeline — number of days, or "none" to hide
NEXT_PUBLIC_JOINING_DAYS=30
# Optional: override the full joining pill text (otherwise built from JOINING_DAYS)
# NEXT_PUBLIC_JOINING_NOTICE=Open to opportunities — can join within 30 days
