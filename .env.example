# ============================================
# PRATIK SHARMA PORTFOLIO — ENV VARIABLES
# Copy this to .env.local and fill in values
# ============================================

# Admin Panel Password (choose a strong password)
ADMIN_PASSWORD=your_strong_password_here

# JWT Secret (random 32+ char string)
JWT_SECRET=your_jwt_secret_here_make_it_long_and_random

# Email (Nodemailer via Gmail SMTP)
# Enable "App Passwords" in your Google Account > Security
GMAIL_USER=pratik.sde16@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password_here
CONTACT_RECEIVER=pratik.sde16@gmail.com

# Google Analytics (from analytics.google.com)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://pratik-portfolio-oevs.vercel.app
